DJANGO_SECRET_KEY=dev-only-change-this-key-before-deployment
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Production only: set DJANGO_SETTINGS_MODULE=config.settings.production,
# replace DJANGO_SECRET_KEY, and set DATABASE_URL to your PostgreSQL URL.
